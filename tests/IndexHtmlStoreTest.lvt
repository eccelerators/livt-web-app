namespace Livt.WebApp.Tests

using Livt.Net
using Livt.WebApp

@Test
component IndexHtmlStoreTest
{
	store: IndexHtmlStore

	/**
	 * Constructs the body provider.
	 */
	new()
	{
		this.store = new IndexHtmlStore()
	}

	@Test
	/**
	 * Checks independent body samples, extent and invalid-read behavior.
	 */
	fn PublishesCheckedBodyBytes()
	{
		assert this.store.IsReady()
		assert this.store.GetAvailableLength() == 1373
		var value: byte = 0x00
		assert this.store.TryRead(0, value) == PacketDataResult.Success
		assert value == 0x3C
		assert this.store.TryRead(1, value) == PacketDataResult.Success
		assert value == 0x21
		assert this.store.TryRead(10, value) == PacketDataResult.Success
		assert value == 0x68
		assert this.store.TryRead(31, value) == PacketDataResult.Success
		assert value == 0x61
		assert this.store.TryRead(69, value) == PacketDataResult.Success
		assert value == 0x77
		assert this.store.TryRead(145, value) == PacketDataResult.Success
		assert value == 0x2E
		assert this.store.TryRead(250, value) == PacketDataResult.Success
		assert value == 0x3B
		assert this.store.TryRead(500, value) == PacketDataResult.Success
		assert value == 0x63
		assert this.store.TryRead(900, value) == PacketDataResult.Success
		assert value == 0x6C
		assert this.store.TryRead(1372, value) == PacketDataResult.Success
		assert value == 0x20
		assert this.store.TryRead(-1, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert this.store.TryRead(1373, value) == PacketDataResult.Invalid
		assert value == 0x00
	}
}
