		this.rx = 0b1
		this.application = new WebApplication<TestFrameReceiver<128>, TestFrameTransmitter<RamPacketData<1514>>>(
			this.receiver, this.transmitter, this.response, mac, ip, port, this.rx, this.tx, this.detected)
	}

	/**
	 * Checks the complete ARP reply and holds prepared storage through TX backpressure.
	 */
	@Test
	fn ServesArpThroughCapabilitiesAndReleasesOnlyAfterCompletion()
	{
		var request: byte[60] = [
			0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,0x02,0x10,0x20,0x30,0x40,0x50,0x08,0x06,
			0x00,0x01,0x08,0x00,0x06,0x04,0x00,0x01,0x02,0x10,0x20,0x30,0x40,0x50,
			0x0A,0x00,0x00,0x02,0x00,0x00,0x00,0x00,0x00,0x00,0x0A,0x00,0x00,0x01,
			0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
			0x00,0x00,0x00,0x00]
		var expected: byte[60] = [
			0x02,0x10,0x20,0x30,0x40,0x50,0x00,0x00,0x5E,0x00,0xFA,0xCE,0x08,0x06,
			0x00,0x01,0x08,0x00,0x06,0x04,0x00,0x02,0x00,0x00,0x5E,0x00,0xFA,0xCE,
			0x0A,0x00,0x00,0x01,0x02,0x10,0x20,0x30,0x40,0x50,0x0A,0x00,0x00,0x02,
			0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
			0x00,0x00,0x00,0x00]

		for (var i = 0; i < 60; i++) {
			assert this.receiver.InjectByte(i, request[i]) == FrameLinkResult.Success
		}

		assert this.receiver.Publish(false, 0) == FrameLinkResult.Success
		var borrowed = false

		for (var i = 0; i < 50000; i++) {
			borrowed = this.transmitter.IsSourceBorrowed()

			if (borrowed) {
				break
			}
		}

		assert borrowed
		assert this.receiver.HasReceiveFrame()
		assert this.response.IsReady()
		assert this.response.GetAvailableLength() == 60
		Simulation.Wait(100)
		assert this.transmitter.IsSourceBorrowed()

		for (var i = 0; i <= 60; i++) {
			this.transmitter.Advance()
		}

		var value: byte = 0x00

		for (var i = 0; i < 60; i++) {
			assert this.transmitter.TryReadCaptured(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		var released = false

		for (var i = 0; i < 1000; i++) {
			released = !this.response.IsReady()

			if (released) {
				break
			}
		}

		assert released
		Simulation.Wait(1000)
		assert !this.receiver.HasReceiveFrame()
		assert !this.transmitter.IsSourceBorrowed()
	}

	/**
	 * Publishes a complete frame and waits for TX, while checking RX retention.
	 */
	fn Submit(request: byte[])
	{
		for (var i = 0; i < request.Length(); i++) {
			assert this.receiver.InjectByte(i, request[i]) == FrameLinkResult.Success
		}
		assert this.receiver.Publish(true, request.Length()) == FrameLinkResult.Success
		var borrowed = false
		// Full-page checksum and checked TX copy exceed the short-frame budget.
		for (var i = 0; i < 1000000; i++) {
			borrowed = this.transmitter.IsSourceBorrowed()
			if (borrowed) {
				break
			}
		}
		assert borrowed
		assert this.receiver.HasReceiveFrame()
	}

	/**
	 * Compares every Ethernet/IP/TCP/HTTP byte, including independently computed checksums.
	 */
	fn CheckTransmission(expected: byte[])
	{
		assert this.response.GetAvailableLength() == expected.Length()
		for (var i = 0; i <= expected.Length(); i++) {
			this.transmitter.Advance()
		}
		var value: byte = 0x00
		for (var i = 0; i < expected.Length(); i++) {
			assert this.transmitter.TryReadCaptured(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}
		this.WaitForRelease()
	}

	/**
	 * Waits for both TX storage and request graph release before another capture.
	 */
	fn WaitForRelease()
	{
		var released = false
		for (var i = 0; i < 10000; i++) {
			released = !this.receiver.HasReceiveFrame() && !this.response.IsReady()
			if (released) {
				break
			}
		}
		assert released
		assert !this.transmitter.IsSourceBorrowed()
	}

	@Test
	/**
	 * Exercises the actual process, default server assembly and full HTML frame under TX backpressure.
	 */
	fn ServesCompleteHomeFrameAfterHandshake()
	{
		this.WaitForRelease()
		Simulation.Report("Home integration: begin handshake")
		this.Submit(SYN_REQUEST)
		this.CheckTransmission(SYN_RESPONSE)
		Simulation.Report("Home integration: handshake complete, submit request")
		this.Submit(HOME_REQUEST)
		Simulation.Report("Home integration: response prepared")
		Simulation.Wait(100)
		assert this.receiver.HasReceiveFrame()
		assert this.response.IsReady()
		this.CheckTransmission(HOME_RESPONSE)
		Simulation.Report("Home integration: complete frame verified and released")
	}

	@Test
	/**
	 * Failed transmission must close borrowers and permit fresh connection setup.
	 */
	fn TransmitFailureReleasesGraphAndAllowsNewHandshake()
	{
		this.WaitForRelease()
		this.Submit(SYN_REQUEST)
		this.transmitter.SetFailure(true)
		this.transmitter.Advance()
		this.WaitForRelease()
		this.transmitter.SetFailure(false)
		this.Submit(SYN_REQUEST)
		this.CheckTransmission(SYN_RESPONSE)
	}
}
