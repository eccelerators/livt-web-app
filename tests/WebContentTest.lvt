namespace Livt.WebApp.Tests
using Livt.Net
using Livt.Web.Http
using Livt.WebApp

/** The app's real stores satisfy the selected-body ownership contract. */
@Test
component WebContentTest
{
	index: IndexHtmlStore
	about: AboutHtmlStore
	status: StatusHtmlStore
	content: WebContent
	response: HttpResponseFrameComposer<WebContent>

	new()
	{
		this.index = new IndexHtmlStore()
		this.about = new AboutHtmlStore()
		this.status = new StatusHtmlStore()
		this.content = new WebContent(this.index, this.about, this.status)
		this.response = new HttpResponseFrameComposer<WebContent>(this.content)
	}

	@Test
	fn PublishesRealRoutesAndRejectsReplacement()
	{
		this.response.Invalidate()
		this.content.Release()

		for (var i = 0; i < 2000; i++) {

			if (this.index.IsReady() && this.about.IsReady() && this.status.IsReady()) {
				break
			}
		}

		assert this.index.IsReady()
		assert this.about.IsReady()
		assert this.status.IsReady()
		var value: byte = 0xFF
		assert this.content.TryRead(0, value) == PacketDataResult.NotReady
		assert this.content.TrySelect(0) == PacketDataResult.Invalid

		for (var route = 1; route <= 3; route++) {
			assert this.content.TrySelect(route) == PacketDataResult.Success
			assert this.content.TrySelect(route) == PacketDataResult.Busy
			assert this.content.TryRead(0, value) == PacketDataResult.Success
			assert value == 0x3C
			var length = this.content.GetAvailableLength()
			assert length > 0
			assert this.content.TryRead(length, value) == PacketDataResult.Invalid
			this.content.Release()
		}

		assert !this.content.IsReady()
		assert this.content.GetAvailableLength() == 0
	}

	@Test
	fn PreparesStatusFrameBeforeReleasingForCounterUpdate()
	{
		this.response.Invalidate()
		this.content.Release()
		this.status.SetCounters(1, 2, 3, 4, 5, 6)

		for (var i = 0; i < 2000; i++) {

			if (this.status.IsReady()) {
				break
			}
		}

		assert this.content.TrySelect(3) == PacketDataResult.Success
		var mac: byte[6] = [0x02, 0x00, 0x00, 0x00, 0x00, 0x01]
		var ip: byte[4] = [0x0A, 0x00, 0x00, 0x01]
		var port: byte[2] = [0x00, 0x50]
		var sequence: byte[4] = [0x00, 0x00, 0x00, 0x02]
		assert this.response.TryPrepare(mac, mac, ip, ip, port, port, sequence, sequence, 0x19, port) == PacketDataResult.Success
		// 54 bytes of network headers + 66 HTTP header bytes + 1388 body bytes.
		assert this.response.GetAvailableLength() == 1508
		var value: byte = 0x00
		assert this.response.TryRead(1261, value) == PacketDataResult.Success
		assert value == 0x31
		this.response.Invalidate()
		this.content.Release()
		this.status.SetCounters(2, 2, 3, 4, 5, 6)
		assert this.response.TryRead(1261, value) == PacketDataResult.NotReady
	}
}
