namespace Livt.WebApp.Tests

using Livt.Net
using Livt.WebApp

@Test
component StatusHtmlStoreTest
{
	store: StatusHtmlStore

	/**
	 * Constructs the body provider.
	 */
	new()
	{
		this.store = new StatusHtmlStore()
	}

	@Test
	/**
	 * Checks independent body samples, extent and invalid-read behavior.
	 */
	fn PublishesCheckedBodyBytes()
	{
		assert this.store.IsReady()
		assert this.store.GetAvailableLength() == 1373
		var value: byte = 0x00
		this.store.SetCounters(10, 11, 12, 13, 14, 15)
		assert this.store.TryRead(1126, value) == PacketDataResult.Success
		assert value == 65
		assert this.store.TryRead(1160, value) == PacketDataResult.Success
		assert value == 66
		assert this.store.TryRead(1197, value) == PacketDataResult.Success
		assert value == 67
		assert this.store.TryRead(1232, value) == PacketDataResult.Success
		assert value == 68
		assert this.store.TryRead(1272, value) == PacketDataResult.Success
		assert value == 69
		assert this.store.TryRead(1313, value) == PacketDataResult.Success
		assert value == 70
		assert this.store.TryRead(-1, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert this.store.TryRead(1373, value) == PacketDataResult.Invalid
		assert value == 0x00
	}
}
