namespace Livt.WebApp.Tests

using Livt.Net
using Livt.WebApp

@Test
component AboutHtmlStoreTest
{
	store: AboutHtmlStore

	/**
	 * Constructs the body provider.
	 */
	new()
	{
		this.store = new AboutHtmlStore()
	}

	@Test
	/**
	 * Checks independent body samples, extent and invalid-read behavior.
	 */
	fn PublishesCheckedBodyBytes()
	{
		assert this.store.IsReady()
		assert this.store.GetAvailableLength() == 1322
		var value: byte = 0x00
		var start = "<!doctype html><html>".Encode()
		for (var i = 0; i < start.Length(); i++) {
			assert this.store.TryRead(i, value) == PacketDataResult.Success
			assert value == start[i]
		}
		var end = "</body></html>".Encode()
		for (var i = 0; i < end.Length(); i++) {
			assert this.store.TryRead(1308 + i, value) == PacketDataResult.Success
			assert value == end[i]
		}
		assert this.store.TryRead(-1, value) == PacketDataResult.Invalid
		assert value == 0x00
		assert this.store.TryRead(1322, value) == PacketDataResult.Invalid
		assert value == 0x00
	}
}
