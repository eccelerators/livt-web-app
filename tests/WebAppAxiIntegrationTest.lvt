namespace Livt.WebApp.Tests

using Livt.Net
using Livt.WebApp

@Test
component WebAppAxiIntegrationTest
{
	const AXI_RESP_OKAY: logic[2] = 0b00
	const AXI_STRB_ALL: logic[4] = 0b1111
	const TX_PING_BASE: logic[13] = 0b0000000000000
	const TX_PING_BASE_PLUS_4: logic[13] = 0b0000000000100
	const TX_PING_LENGTH: logic[13] = 0b0011111110100
	const TX_PING_CONTROL: logic[13] = 0b0011111111100
	const TX_PING_IDLE: logic[32] = 0x00000000
	const TX_TEST_FRAME_LENGTH: logic[32] = 0x0000003C
	const TX_TEST_START: logic[32] = 0x00000001
	const TX_PROGRAM_MAC: logic[32] = 0x00000003
	const TX_PROGRAM_MAC_WORD0: logic[32] = 0x005E0000
	const TX_PROGRAM_MAC_WORD1: logic[32] = 0x0000CEFA
	const TX_ARP_REPLY_WORD0: logic[32] = 0x30201002
	const TX_ARP_REPLY_WORD1: logic[32] = 0x00005040
	const TX_ARP_REPLY_WORD2: logic[32] = 0xCEFA005E
	const TX_ARP_REPLY_WORD5: logic[32] = 0x00000200
	const TX_ARP_REPLY_WORD14: logic[32] = 0x00000000
	const TX_ICMP_REPLY_WORD0: logic[32] = 0x30201002
	const TX_ICMP_REPLY_WORD1: logic[32] = 0x00005040
	const TX_ICMP_REPLY_WORD2: logic[32] = 0xCEFA005E
	const TX_ICMP_REPLY_WORD3: logic[32] = 0x00450008
	const TX_ICMP_REPLY_WORD6: logic[32] = 0x000A9F14
	const TX_ICMP_REPLY_WORD8: logic[32] = 0x00000200
	const TX_ICMP_REPLY_WORD9: logic[32] = 0x34125E87
	const TX_ICMP_REPLY_WORD13: logic[32] = 0x00006C6B
	const RX_PING_CONTROL: logic[13] = 0b1011111111100
	const RX_PING_BASE: logic[13] = 0b1000000000000
	const RX_PING_BASE_PLUS_4: logic[13] = 0b1000000000100
	const RX_PING_BASE_PLUS_8: logic[13] = 0b1000000001000
	const RX_PONG_CONTROL: logic[13] = 0b1111111111100
	const RX_PONG_BASE: logic[13] = 0b1100000000000
	const RX_PING_NO_FRAME: logic[32] = 0x00000000
	const RX_PING_HAS_FRAME: logic[32] = 0x00000001
	const RX_FRAME_WORD: logic[32] = 0x11223344
	const RX_ARP_REQUEST_WORD0: logic[32] = 0xFFFFFFFF
	const RX_ARP_REQUEST_WORD1: logic[32] = 0x1002FFFF
	const RX_ARP_REQUEST_WORD2: logic[32] = 0x50403020
	const RX_ARP_REQUEST_WORD3: logic[32] = 0x01000608
	const RX_ARP_REQUEST_WORD4: logic[32] = 0x04060008
	const RX_ARP_REQUEST_WORD5: logic[32] = 0x10020100
	const RX_ARP_REQUEST_WORD6: logic[32] = 0x50403020
	const RX_ARP_REQUEST_WORD7: logic[32] = 0x0200000A
	const RX_ARP_REQUEST_WORD8: logic[32] = 0x00000000
	const RX_ARP_REQUEST_WORD9: logic[32] = 0x000A0000
	const RX_ARP_REQUEST_WORD10: logic[32] = 0x00000100
	const RX_ICMP_REQUEST_WORD0: logic[32] = 0x005E0000
	const RX_ICMP_REQUEST_WORD1: logic[32] = 0x1002CEFA
	const RX_ICMP_REQUEST_WORD2: logic[32] = 0x50403020
	const RX_ICMP_REQUEST_WORD3: logic[32] = 0x00450008
	const RX_ICMP_REQUEST_WORD4: logic[32] = 0x34122800
	const RX_ICMP_REQUEST_WORD5: logic[32] = 0x01400040
	const RX_ICMP_REQUEST_WORD6: logic[32] = 0x000A0000
	const RX_ICMP_REQUEST_WORD7: logic[32] = 0x000A0200
	const RX_ICMP_REQUEST_WORD8: logic[32] = 0x00080100
	const RX_ICMP_REQUEST_WORD9: logic[32] = 0x34125E7F
	const RX_ICMP_REQUEST_WORD10: logic[32] = 0x62610100
	const RX_ICMP_REQUEST_WORD11: logic[32] = 0x66656463
	const RX_ICMP_REQUEST_WORD12: logic[32] = 0x6A696867
	const RX_ICMP_REQUEST_WORD13: logic[32] = 0x00006C6B
	const RX_ICMP_REQUEST_WORD14: logic[32] = 0x00000000
	const RX_CONTROL_RELEASE: logic[32] = 0x00000000

	axi: Axi4LiteEthernetLiteAdapter

	server: WebApp
	
	rx: logic
	
	tx: logic

	ethernet_frame_detected: logic

	multiAxi: Axi4LiteEthernetLiteAdapter

	multiServer: WebApp

	multi_rx: logic

	multi_tx: logic

	multi_ethernet_frame_detected: logic

	earlyAxi: Axi4LiteEthernetLiteAdapter

	earlyServer: WebApp

	early_rx: logic

	early_tx: logic

	early_ethernet_frame_detected: logic

	fullAxi: Axi4LiteEthernetLiteAdapter

	fullServer: WebApp

	full_rx: logic

	full_tx: logic

	full_ethernet_frame_detected: logic

	new()
	{
		var localMac: byte[6]
		localMac[0] = 0x00
		localMac[1] = 0x00
		localMac[2] = 0x5E
		localMac[3] = 0x00
		localMac[4] = 0xFA
		localMac[5] = 0xCE
		var localIp: byte[4]
		localIp[0] = 0x0A
		localIp[1] = 0x00
		localIp[2] = 0x00
		localIp[3] = 0x01
		var localPort: byte[2]
		localPort[0] = 0x00
		localPort[1] = 0x50
		this.axi = new Axi4LiteEthernetLiteAdapter()
		this.server = new WebApp(
			this.axi,
			localMac,
			localIp,
			localPort,
			this.rx,
			this.tx,
			this.ethernet_frame_detected
		)

		var multiLocalMac: byte[6]
		multiLocalMac[0] = 0x00
		multiLocalMac[1] = 0x00
		multiLocalMac[2] = 0x5E
		multiLocalMac[3] = 0x00
		multiLocalMac[4] = 0xFA
		multiLocalMac[5] = 0xCE
		var multiLocalIp: byte[4]
		multiLocalIp[0] = 0x0A
		multiLocalIp[1] = 0x00
		multiLocalIp[2] = 0x00
		multiLocalIp[3] = 0x01
		var multiLocalPort: byte[2]
		multiLocalPort[0] = 0x00
		multiLocalPort[1] = 0x50
		this.multiAxi = new Axi4LiteEthernetLiteAdapter()
		this.multiServer = new WebApp(
			this.multiAxi,
			multiLocalMac,
			multiLocalIp,
			multiLocalPort,
			this.multi_rx,
			this.multi_tx,
			this.multi_ethernet_frame_detected
		)

		var earlyLocalMac: byte[6]
		earlyLocalMac[0] = 0x00
		earlyLocalMac[1] = 0x00
		earlyLocalMac[2] = 0x5E
		earlyLocalMac[3] = 0x00
		earlyLocalMac[4] = 0xFA
		earlyLocalMac[5] = 0xCE
		var earlyLocalIp: byte[4]
		earlyLocalIp[0] = 0x0A
		earlyLocalIp[1] = 0x00
		earlyLocalIp[2] = 0x00
		earlyLocalIp[3] = 0x01
		var earlyLocalPort: byte[2]
		earlyLocalPort[0] = 0x00
		earlyLocalPort[1] = 0x50
		this.earlyAxi = new Axi4LiteEthernetLiteAdapter()
		this.earlyServer = new WebApp(
			this.earlyAxi,
			earlyLocalMac,
			earlyLocalIp,
			earlyLocalPort,
			this.early_rx,
			this.early_tx,
			this.early_ethernet_frame_detected
		)

		var fullLocalMac: byte[6]
		fullLocalMac[0] = 0x00
		fullLocalMac[1] = 0x00
		fullLocalMac[2] = 0x5E
		fullLocalMac[3] = 0x00
		fullLocalMac[4] = 0xFA
		fullLocalMac[5] = 0xCE
		var fullLocalIp: byte[4]
		fullLocalIp[0] = 0x0A
		fullLocalIp[1] = 0x00
		fullLocalIp[2] = 0x00
		fullLocalIp[3] = 0x01
		var fullLocalPort: byte[2]
		fullLocalPort[0] = 0x00
		fullLocalPort[1] = 0x50
		this.fullAxi = new Axi4LiteEthernetLiteAdapter()
		this.fullServer = new WebApp(
			this.fullAxi,
			fullLocalMac,
			fullLocalIp,
			fullLocalPort,
			this.full_rx,
			this.full_tx,
			this.full_ethernet_frame_detected
		)
	}

	fn ProgramDefaultMacOnMainAxi()
	{
		var hasReadAddress = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasReadAddress == false)
			{
				if (this.server.GetAxiArvalid() == 0b1)
				{
					assert this.server.GetAxiAraddr() == TX_PING_CONTROL
					assert this.server.GetAxiRready() == 0b0
					hasReadAddress = true
					this.axi.m_axi_arready = 0b1
				}
			}

			Simulation.Wait(1)
			this.axi.m_axi_arready = 0b0
		}

		assert hasReadAddress == true
		assert this.server.GetAxiArvalid() == 0b0
		assert this.server.GetAxiRready() == 0b1

		this.axi.m_axi_rdata = TX_PING_IDLE
		this.axi.m_axi_rresp = AXI_RESP_OKAY
		this.axi.m_axi_rvalid = 0b1
		var hasAcceptedMacDoneReadResponse = false
		hasAcceptedMacDoneReadResponse = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasAcceptedMacDoneReadResponse == false)
			{
				if (this.server.GetAxiRready() == 0b0)
				{
					hasAcceptedMacDoneReadResponse = true
				}
			}

			Simulation.Wait(1)
		}

		assert hasAcceptedMacDoneReadResponse == true
		this.axi.m_axi_rvalid = 0b0
		Simulation.Wait(1)

		for (var writeIndex = 0; writeIndex < 3; writeIndex++)
		{
			var expectedAddress: logic[13] = TX_PING_CONTROL
			var expectedData: logic[32] = TX_PROGRAM_MAC

			if (writeIndex == 0)
			{
				expectedAddress = TX_PING_BASE
				expectedData = TX_PROGRAM_MAC_WORD0
			}

			if (writeIndex == 1)
			{
				expectedAddress = TX_PING_BASE_PLUS_4
				expectedData = TX_PROGRAM_MAC_WORD1
			}

			var hasAcceptedAddress = false
			var hasAcceptedData = false
			hasAcceptedAddress = false
			hasAcceptedData = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedAddress == false)
				{
					if (this.server.GetAxiAwvalid() == 0b1)
					{
						assert this.server.GetAxiAwaddr() == expectedAddress
						hasAcceptedAddress = true
						this.axi.m_axi_awready = 0b1
					}
				}

				if (hasAcceptedData == false)
				{
					if (this.server.GetAxiWvalid() == 0b1)
					{
						assert this.server.GetAxiWdata() == expectedData
						assert this.server.GetAxiWstrb() == AXI_STRB_ALL
						hasAcceptedData = true
						this.axi.m_axi_wready = 0b1
					}
				}

				Simulation.Wait(1)
				this.axi.m_axi_awready = 0b0
				this.axi.m_axi_wready = 0b0
			}

			assert hasAcceptedAddress == true
			assert hasAcceptedData == true

			var hasAcceptedWriteResponse = false
			hasAcceptedWriteResponse = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedWriteResponse == false)
				{
					if (this.server.GetAxiBready() == 0b1)
					{
						hasAcceptedWriteResponse = true
						this.axi.m_axi_bvalid = 0b1
					}
				}

				Simulation.Wait(1)

				if (hasAcceptedWriteResponse == true)
				{
					this.axi.m_axi_bvalid = 0b0
				}
			}

			assert hasAcceptedWriteResponse == true
			Simulation.Wait(1)
		}

		Simulation.Wait(10)
		var hasDrainedTxControlRead = false
		hasDrainedTxControlRead = false

		for (var cycle = 0; cycle < 50; cycle++)
		{
			if (hasDrainedTxControlRead == false)
			{
				if (this.server.GetAxiArvalid() == 0b1)
				{
					if (this.server.GetAxiAraddr() == TX_PING_CONTROL)
					{
						hasDrainedTxControlRead = true
						this.axi.m_axi_arready = 0b1
					}
				}
			}

			Simulation.Wait(1)
			this.axi.m_axi_arready = 0b0
		}

		if (hasDrainedTxControlRead == true)
		{
			this.axi.m_axi_rdata = TX_PING_IDLE
			this.axi.m_axi_rresp = AXI_RESP_OKAY
			this.axi.m_axi_rvalid = 0b1
			Simulation.Wait(20)
			this.axi.m_axi_rvalid = 0b0
			Simulation.Wait(10)
		}
	}

	fn ProgramDefaultMacOnMultiAxi()
	{
		var hasReadAddress = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasReadAddress == false)
			{
				if (this.multiServer.GetAxiArvalid() == 0b1)
				{
					assert this.multiServer.GetAxiAraddr() == TX_PING_CONTROL
					assert this.multiServer.GetAxiRready() == 0b0
					hasReadAddress = true
					this.multiAxi.m_axi_arready = 0b1
				}
			}

			Simulation.Wait(1)
			this.multiAxi.m_axi_arready = 0b0
		}

		assert hasReadAddress == true
		assert this.multiServer.GetAxiArvalid() == 0b0
		assert this.multiServer.GetAxiRready() == 0b1

		this.multiAxi.m_axi_rdata = TX_PING_IDLE
		this.multiAxi.m_axi_rresp = AXI_RESP_OKAY
		this.multiAxi.m_axi_rvalid = 0b1
		var hasAcceptedMacDoneReadResponse = false
		hasAcceptedMacDoneReadResponse = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasAcceptedMacDoneReadResponse == false)
			{
				if (this.multiServer.GetAxiRready() == 0b0)
				{
					hasAcceptedMacDoneReadResponse = true
				}
			}

			Simulation.Wait(1)
		}

		assert hasAcceptedMacDoneReadResponse == true
		this.multiAxi.m_axi_rvalid = 0b0
		Simulation.Wait(1)

		for (var writeIndex = 0; writeIndex < 3; writeIndex++)
		{
			var expectedAddress: logic[13] = TX_PING_CONTROL
			var expectedData: logic[32] = TX_PROGRAM_MAC

			if (writeIndex == 0)
			{
				expectedAddress = TX_PING_BASE
				expectedData = TX_PROGRAM_MAC_WORD0
			}

			if (writeIndex == 1)
			{
				expectedAddress = TX_PING_BASE_PLUS_4
				expectedData = TX_PROGRAM_MAC_WORD1
			}

			var hasAcceptedAddress = false
			var hasAcceptedData = false
			hasAcceptedAddress = false
			hasAcceptedData = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedAddress == false)
				{
					if (this.multiServer.GetAxiAwvalid() == 0b1)
					{
						assert this.multiServer.GetAxiAwaddr() == expectedAddress
						hasAcceptedAddress = true
						this.multiAxi.m_axi_awready = 0b1
					}
				}

				if (hasAcceptedData == false)
				{
					if (this.multiServer.GetAxiWvalid() == 0b1)
					{
						assert this.multiServer.GetAxiWdata() == expectedData
						assert this.multiServer.GetAxiWstrb() == AXI_STRB_ALL
						hasAcceptedData = true
						this.multiAxi.m_axi_wready = 0b1
					}
				}

				Simulation.Wait(1)
				this.multiAxi.m_axi_awready = 0b0
				this.multiAxi.m_axi_wready = 0b0
			}

			assert hasAcceptedAddress == true
			assert hasAcceptedData == true

			var hasAcceptedWriteResponse = false
			hasAcceptedWriteResponse = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedWriteResponse == false)
				{
					if (this.multiServer.GetAxiBready() == 0b1)
					{
						hasAcceptedWriteResponse = true
						this.multiAxi.m_axi_bvalid = 0b1
					}
				}

				Simulation.Wait(1)

				if (hasAcceptedWriteResponse == true)
				{
					this.multiAxi.m_axi_bvalid = 0b0
				}
			}

			assert hasAcceptedWriteResponse == true
			Simulation.Wait(1)
		}

		Simulation.Wait(10)
		var hasDrainedTxControlRead = false
		hasDrainedTxControlRead = false

		for (var cycle = 0; cycle < 50; cycle++)
		{
			if (hasDrainedTxControlRead == false)
			{
				if (this.multiServer.GetAxiArvalid() == 0b1)
				{
					if (this.multiServer.GetAxiAraddr() == TX_PING_CONTROL)
					{
						hasDrainedTxControlRead = true
						this.multiAxi.m_axi_arready = 0b1
					}
				}
			}

			Simulation.Wait(1)
			this.multiAxi.m_axi_arready = 0b0
		}

		if (hasDrainedTxControlRead == true)
		{
			this.multiAxi.m_axi_rdata = TX_PING_IDLE
			this.multiAxi.m_axi_rresp = AXI_RESP_OKAY
			this.multiAxi.m_axi_rvalid = 0b1
			Simulation.Wait(20)
			this.multiAxi.m_axi_rvalid = 0b0
			Simulation.Wait(10)
		}
	}

	fn ProgramDefaultMacOnEarlyAxi()
	{
		var hasReadAddress = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasReadAddress == false)
			{
