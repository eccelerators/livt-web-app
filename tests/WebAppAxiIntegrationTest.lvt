	fn ProgramDefaultMacOnFullAxi()
	{
		var hasReadAddress = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasReadAddress == false)
			{
				if (this.fullServer.GetAxiArvalid() == 0b1)
				{
					assert this.fullServer.GetAxiAraddr() == TX_PING_CONTROL
					assert this.fullServer.GetAxiRready() == 0b0
					hasReadAddress = true
					this.fullAxi.m_axi_arready = 0b1
				}
			}

			Simulation.Wait(1)
			this.fullAxi.m_axi_arready = 0b0
		}

		assert hasReadAddress == true
		assert this.fullServer.GetAxiArvalid() == 0b0
		assert this.fullServer.GetAxiRready() == 0b1

		this.fullAxi.m_axi_rdata = TX_PING_IDLE
		this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
		this.fullAxi.m_axi_rvalid = 0b1
		var hasAcceptedMacDoneReadResponse = false
		hasAcceptedMacDoneReadResponse = false

		for (var cycle = 0; cycle < 100; cycle++)
		{
			if (hasAcceptedMacDoneReadResponse == false)
			{
				if (this.fullServer.GetAxiRready() == 0b0)
				{
					hasAcceptedMacDoneReadResponse = true
				}
			}

			Simulation.Wait(1)
		}

		assert hasAcceptedMacDoneReadResponse == true
		this.fullAxi.m_axi_rvalid = 0b0
		Simulation.Wait(1)

		for (var writeIndex = 0; writeIndex < 3; writeIndex++)
		{
			var expectedAddress: logic[13] = TX_PING_CONTROL
			var expectedData: logic[32] = TX_PROGRAM_MAC

			if (writeIndex == 0)
			{
				expectedAddress = TX_PING_BASE
				expectedData = TX_PROGRAM_MAC_WORD0
			}

			if (writeIndex == 1)
			{
				expectedAddress = TX_PING_BASE_PLUS_4
				expectedData = TX_PROGRAM_MAC_WORD1
			}

			var hasAcceptedAddress = false
			var hasAcceptedData = false
			hasAcceptedAddress = false
			hasAcceptedData = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedAddress == false)
				{
					if (this.fullServer.GetAxiAwvalid() == 0b1)
					{
						assert this.fullServer.GetAxiAwaddr() == expectedAddress
						hasAcceptedAddress = true
						this.fullAxi.m_axi_awready = 0b1
					}
				}

				if (hasAcceptedData == false)
				{
					if (this.fullServer.GetAxiWvalid() == 0b1)
					{
						assert this.fullServer.GetAxiWdata() == expectedData
						assert this.fullServer.GetAxiWstrb() == AXI_STRB_ALL
						hasAcceptedData = true
						this.fullAxi.m_axi_wready = 0b1
					}
				}

				Simulation.Wait(1)
				this.fullAxi.m_axi_awready = 0b0
				this.fullAxi.m_axi_wready = 0b0
			}

			assert hasAcceptedAddress == true
			assert hasAcceptedData == true

			var hasAcceptedWriteResponse = false
			hasAcceptedWriteResponse = false

			for (var cycle = 0; cycle < 100; cycle++)
			{
				if (hasAcceptedWriteResponse == false)
				{
					if (this.fullServer.GetAxiBready() == 0b1)
					{
						hasAcceptedWriteResponse = true
						this.fullAxi.m_axi_bvalid = 0b1
					}
				}

				Simulation.Wait(1)

				if (hasAcceptedWriteResponse == true)
				{
					this.fullAxi.m_axi_bvalid = 0b0
				}
			}

			assert hasAcceptedWriteResponse == true
			Simulation.Wait(1)
		}

		Simulation.Wait(10)
		var hasDrainedTxControlRead = false
		hasDrainedTxControlRead = false

		for (var cycle = 0; cycle < 50; cycle++)
		{
			if (hasDrainedTxControlRead == false)
			{
				if (this.fullServer.GetAxiArvalid() == 0b1)
				{
					if (this.fullServer.GetAxiAraddr() == TX_PING_CONTROL)
					{
						hasDrainedTxControlRead = true
						this.fullAxi.m_axi_arready = 0b1
					}
				}
			}

			Simulation.Wait(1)
			this.fullAxi.m_axi_arready = 0b0
		}

		if (hasDrainedTxControlRead == true)
		{
			this.fullAxi.m_axi_rdata = TX_PING_IDLE
			this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
			this.fullAxi.m_axi_rvalid = 0b1
			Simulation.Wait(20)
			this.fullAxi.m_axi_rvalid = 0b0
			Simulation.Wait(10)
		}
	}

	@Test
	fn ReadsMultipleRxPingFrameWords()
	{
		this.multiAxi.m_axi_awready = 0b0
		this.multiAxi.m_axi_wready = 0b0
		this.multiAxi.m_axi_bresp = AXI_RESP_OKAY
		this.multiAxi.m_axi_bvalid = 0b0
		this.multiAxi.m_axi_arready = 0b0
		this.multiAxi.m_axi_rdata = 0x00000000
		this.multiAxi.m_axi_rresp = AXI_RESP_OKAY
		this.multiAxi.m_axi_rvalid = 0b0
		this.multi_rx = 0b1

		this.ProgramDefaultMacOnMultiAxi()

		var hasReadAddress = false

		for (var readIndex = 0; readIndex < 4; readIndex++)
		{
			hasReadAddress = false

			for (var cycle = 0; cycle < 30; cycle++)
			{
				if (hasReadAddress == false)
				{
					if (this.multiServer.GetAxiArvalid() == 0b1)
					{
						if (readIndex == 0)
						{
							assert this.multiServer.GetAxiAraddr() == RX_PING_CONTROL
						}

						if (readIndex == 1)
						{
							assert this.multiServer.GetAxiAraddr() == RX_PING_BASE
						}

						if (readIndex == 2)
						{
							assert this.multiServer.GetAxiAraddr() == RX_PING_BASE_PLUS_4
						}

						if (readIndex == 3)
						{
							assert this.multiServer.GetAxiAraddr() == RX_PING_BASE_PLUS_8
						}

						assert this.multiServer.GetAxiRready() == 0b0

						hasReadAddress = true
						this.multiAxi.m_axi_arready = 0b1
					}
				}

				Simulation.Wait(1)

				this.multiAxi.m_axi_arready = 0b0
			}

			assert hasReadAddress == true
			assert this.multiServer.GetAxiArvalid() == 0b0
			assert this.multiServer.GetAxiRready() == 0b1

			if (readIndex == 0)
			{
				this.multiAxi.m_axi_rdata = RX_PING_HAS_FRAME
			}
			else
			{
				this.multiAxi.m_axi_rdata = RX_FRAME_WORD
			}

			this.multiAxi.m_axi_rresp = AXI_RESP_OKAY
			this.multiAxi.m_axi_rvalid = 0b1

			Simulation.Wait(1)

			this.multiAxi.m_axi_rvalid = 0b0

			Simulation.Wait(1)
		}
	}

	@Test
	fn AcceptsReadDataThatIsValidBeforeReadyIsObserved()
	{
		this.earlyAxi.m_axi_awready = 0b0
		this.earlyAxi.m_axi_wready = 0b0
		this.earlyAxi.m_axi_bresp = AXI_RESP_OKAY
		this.earlyAxi.m_axi_bvalid = 0b0
		this.earlyAxi.m_axi_arready = 0b0
		this.earlyAxi.m_axi_rdata = RX_PING_NO_FRAME
		this.earlyAxi.m_axi_rresp = AXI_RESP_OKAY
		this.earlyAxi.m_axi_rvalid = 0b0
		this.early_rx = 0b1

		this.ProgramDefaultMacOnEarlyAxi()

		var hasReadAddress = false
		var hasSeenReadReady = false

		for (var cycle = 0; cycle < 200; cycle++)
		{
			if (hasReadAddress == false)
			{
				if (this.earlyServer.GetAxiArvalid() == 0b1)
				{
					assert this.earlyServer.GetAxiAraddr() == RX_PING_CONTROL
					assert this.earlyServer.GetAxiRready() == 0b0

					hasReadAddress = true
					this.earlyAxi.m_axi_arready = 0b1
				}
			}
			else
			{
				this.earlyAxi.m_axi_rvalid = 0b1
			}

			if (hasReadAddress == true && this.earlyServer.GetAxiRready() == 0b1)
			{
				hasSeenReadReady = true
				this.earlyAxi.m_axi_rvalid = 0b0
			}

			Simulation.Wait(1)

			this.earlyAxi.m_axi_arready = 0b0
		}

		assert hasReadAddress == true
		assert hasSeenReadReady == true
	}

	@Test
	fn ReadsCompleteRxPingEthernetFrame()
	{
		this.fullAxi.m_axi_awready = 0b0
		this.fullAxi.m_axi_wready = 0b0
		this.fullAxi.m_axi_bresp = AXI_RESP_OKAY
		this.fullAxi.m_axi_bvalid = 0b0
		this.fullAxi.m_axi_arready = 0b0
		this.fullAxi.m_axi_rdata = 0x00000000
		this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
		this.fullAxi.m_axi_rvalid = 0b0
		this.full_rx = 0b1

		this.ProgramDefaultMacOnFullAxi()

		var hasReadAddress = false
		for (var readIndex = 0; readIndex < 33; readIndex++)
		{
			hasReadAddress = false

			for (var cycle = 0; cycle < 30; cycle++)
			{
				if (hasReadAddress == false)
				{
					if (this.fullServer.GetAxiArvalid() == 0b1)
					{
							if (readIndex == 0)
							{
								assert this.fullServer.GetAxiAraddr() == RX_PING_CONTROL
							}
							if (readIndex == 1)
							{
								assert this.fullServer.GetAxiAraddr() == RX_PING_BASE
							}
							if (readIndex == 2)
							{
								assert this.fullServer.GetAxiAraddr() == RX_PING_BASE_PLUS_4
							}
							if (readIndex == 3)
							{
								assert this.fullServer.GetAxiAraddr() == RX_PING_BASE_PLUS_8
							}

						assert this.fullServer.GetAxiRready() == 0b0

						hasReadAddress = true
						this.fullAxi.m_axi_arready = 0b1
					}
				}

				Simulation.Wait(1)

				this.fullAxi.m_axi_arready = 0b0
			}

			assert hasReadAddress == true
			assert this.fullServer.GetAxiArvalid() == 0b0
			assert this.fullServer.GetAxiRready() == 0b1

			if (readIndex == 0)
			{
				this.fullAxi.m_axi_rdata = RX_PING_HAS_FRAME
			}
			else
			{
				this.fullAxi.m_axi_rdata = 0x00000000
				if (readIndex == 1) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD0 }
				if (readIndex == 2) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD1 }
				if (readIndex == 3) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD2 }
				if (readIndex == 4) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD3 }
				if (readIndex == 5) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD4 }
				if (readIndex == 6) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD5 }
				if (readIndex == 7) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD6 }
				if (readIndex == 8) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD7 }
				if (readIndex == 9) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD8 }
				if (readIndex == 10) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD9 }
				if (readIndex == 11) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD10 }
				if (readIndex == 12) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD11 }
				if (readIndex == 13) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD12 }
				if (readIndex == 14) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD13 }
				if (readIndex == 15) { this.fullAxi.m_axi_rdata = RX_ICMP_REQUEST_WORD14 }
			}

			this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
			this.fullAxi.m_axi_rvalid = 0b1

			Simulation.Wait(2)

			this.fullAxi.m_axi_rvalid = 0b0

			Simulation.Wait(1)
		}

			var hasClearedRxControlAddress = false
			var hasClearedRxControlData = false
			var hasOfferedWriteResponse = false
			var hasAcceptedWriteResponse = false
			this.fullAxi.m_axi_awready = 0b0
			this.fullAxi.m_axi_wready = 0b0
			this.fullAxi.m_axi_bvalid = 0b0

			for (var cycle = 0; cycle < 300; cycle++)
			{
				if (hasAcceptedWriteResponse == false)
				{
					if (hasClearedRxControlAddress == false)
					{
						if (this.fullServer.GetAxiAwvalid() == 0b1 && this.fullServer.GetAxiAwaddr() == RX_PING_CONTROL)
						{
							assert this.fullServer.GetAxiAwaddr() == RX_PING_CONTROL
							hasClearedRxControlAddress = true
							this.fullAxi.m_axi_awready = 0b1
						}
					}

					if (hasClearedRxControlData == false)
					{
						if (this.fullServer.GetAxiWvalid() == 0b1 && this.fullServer.GetAxiWdata() == RX_CONTROL_RELEASE)
						{
							assert this.fullServer.GetAxiWdata() == RX_CONTROL_RELEASE
							assert this.fullServer.GetAxiWstrb() == AXI_STRB_ALL

							hasClearedRxControlData = true
							this.fullAxi.m_axi_wready = 0b1
						}
					}

					if (hasClearedRxControlAddress && hasClearedRxControlData)
					{
						this.fullAxi.m_axi_bvalid = 0b1
					}

					if (hasOfferedWriteResponse == false)
					{
						if (hasClearedRxControlAddress && hasClearedRxControlData)
						{
							hasOfferedWriteResponse = true
						}
					}
					else
					{
						hasAcceptedWriteResponse = true
					}
				}

				Simulation.Wait(1)

				if (hasOfferedWriteResponse)
				{
					this.fullAxi.m_axi_awready = 0b0
					this.fullAxi.m_axi_wready = 0b0
					this.fullAxi.m_axi_bvalid = 0b1
				}
				else
				{
					if (hasClearedRxControlAddress == false)
					{
						this.fullAxi.m_axi_awready = 0b0
					}

					if (hasClearedRxControlData == false)
					{
						this.fullAxi.m_axi_wready = 0b0
					}
				}
			}

				assert hasClearedRxControlAddress == true
				assert hasClearedRxControlData == true
				assert hasOfferedWriteResponse == true
				this.fullAxi.m_axi_bvalid = 0b0

			var hasPolledTxControl = false
			var sendNoFrameResponse = false

			for (var cycle = 0; cycle < 3000; cycle++)
			{
				if (hasPolledTxControl == false)
				{
					if (sendNoFrameResponse == true)
					{
						this.fullAxi.m_axi_rdata = RX_PING_NO_FRAME
						this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
						this.fullAxi.m_axi_rvalid = 0b1
						sendNoFrameResponse = false
					}
					else
					{
						this.fullAxi.m_axi_rvalid = 0b0

						if (this.fullServer.GetAxiArvalid() == 0b1)
						{
							if (this.fullServer.GetAxiAraddr() == TX_PING_CONTROL)
							{
								hasPolledTxControl = true
								this.fullAxi.m_axi_arready = 0b1
							}
							else
							{
								if (this.fullServer.GetAxiAraddr() == RX_PING_CONTROL || this.fullServer.GetAxiAraddr() == RX_PONG_CONTROL)
								{
									this.fullAxi.m_axi_arready = 0b1
									sendNoFrameResponse = true
								}
							}
						}
					}
				}

				Simulation.Wait(1)

				this.fullAxi.m_axi_arready = 0b0
			}

			assert hasPolledTxControl == true
		assert this.fullServer.GetAxiArvalid() == 0b0
		assert this.fullServer.GetAxiRready() == 0b1

		this.fullAxi.m_axi_rdata = TX_PING_IDLE
		this.fullAxi.m_axi_rresp = AXI_RESP_OKAY
		this.fullAxi.m_axi_rvalid = 0b1

		Simulation.Wait(1)

		this.fullAxi.m_axi_rvalid = 0b0

		Simulation.Wait(1)

				for (var txWordIndex = 0; txWordIndex < 15; txWordIndex++)
				{
				var hasAcceptedTxDataAddress = false
				var hasAcceptedTxData = false
				this.fullAxi.m_axi_awready = 0b0
				this.fullAxi.m_axi_wready = 0b0
				this.fullAxi.m_axi_bvalid = 0b0
				hasAcceptedTxDataAddress = false
				hasAcceptedTxData = false

				for (var cycle = 0; cycle < 200; cycle++)
				{
					if (hasAcceptedTxDataAddress == false)
						{
							if (this.fullServer.GetAxiAwvalid() == 0b1)
							{
								if (txWordIndex == 0)
								{
									assert this.fullServer.GetAxiAwaddr() == TX_PING_BASE
								}
								if (txWordIndex == 1)
								{
									assert this.fullServer.GetAxiAwaddr() == TX_PING_BASE_PLUS_4
								}
								hasAcceptedTxDataAddress = true
							}
						}

					if (hasAcceptedTxData == false)
					{
						if (this.fullServer.GetAxiWvalid() == 0b1)
						{
							assert this.fullServer.GetAxiWstrb() == AXI_STRB_ALL

							if (txWordIndex == 0)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD0
							}

							if (txWordIndex == 1)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD1
							}

							if (txWordIndex == 2)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD2
							}

							if (txWordIndex == 3)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD3
							}

							if (txWordIndex == 6)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD6
							}

							if (txWordIndex == 8)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD8
							}

							if (txWordIndex == 9)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD9
							}

							if (txWordIndex == 13)
							{
								assert this.fullServer.GetAxiWdata() == TX_ICMP_REPLY_WORD13
							}

							if (txWordIndex == 14)
							{
								assert this.fullServer.GetAxiWdata() == TX_ARP_REPLY_WORD14
							}

							hasAcceptedTxData = true
						}
					}

					Simulation.Wait(1)
				}

				assert hasAcceptedTxDataAddress == true
				assert hasAcceptedTxData == true

				this.fullAxi.m_axi_awready = 0b1
				this.fullAxi.m_axi_wready = 0b1
				Simulation.Wait(5)
				this.fullAxi.m_axi_awready = 0b0
				this.fullAxi.m_axi_wready = 0b0
				this.fullAxi.m_axi_bvalid = 0b1
				Simulation.Wait(5)
				this.fullAxi.m_axi_bvalid = 0b0

				}

			var hasWrittenTxLength = false
			this.fullAxi.m_axi_awready = 0b0
			this.fullAxi.m_axi_wready = 0b0
			this.fullAxi.m_axi_bvalid = 0b0

			for (var cycle = 0; cycle < 200; cycle++)
			{
				if (hasWrittenTxLength == false)
				{
					if (this.fullServer.GetAxiAwvalid() == 0b1)
					{
						assert this.fullServer.GetAxiAwaddr() == TX_PING_LENGTH
						assert this.fullServer.GetAxiWvalid() == 0b1
						assert this.fullServer.GetAxiWdata() == TX_TEST_FRAME_LENGTH
						assert this.fullServer.GetAxiWstrb() == AXI_STRB_ALL
						hasWrittenTxLength = true
					}
				}

				Simulation.Wait(1)
			}

			assert hasWrittenTxLength == true
			this.fullAxi.m_axi_awready = 0b1
			this.fullAxi.m_axi_wready = 0b1
			Simulation.Wait(5)
			this.fullAxi.m_axi_awready = 0b0
			this.fullAxi.m_axi_wready = 0b0
			this.fullAxi.m_axi_bvalid = 0b1
			Simulation.Wait(5)
			this.fullAxi.m_axi_bvalid = 0b0

			var hasWrittenTxControl = false
			this.fullAxi.m_axi_awready = 0b0
			this.fullAxi.m_axi_wready = 0b0
			this.fullAxi.m_axi_bvalid = 0b0

			for (var cycle = 0; cycle < 200; cycle++)
			{
				if (hasWrittenTxControl == false)
				{
					if (this.fullServer.GetAxiAwvalid() == 0b1)
					{
						assert this.fullServer.GetAxiAwaddr() == TX_PING_CONTROL
						assert this.fullServer.GetAxiWvalid() == 0b1
						assert this.fullServer.GetAxiWdata() == TX_TEST_START
						assert this.fullServer.GetAxiWstrb() == AXI_STRB_ALL
						hasWrittenTxControl = true
					}
				}

				Simulation.Wait(1)
			}

			assert hasWrittenTxControl == true
			this.fullAxi.m_axi_awready = 0b1
			this.fullAxi.m_axi_wready = 0b1
			Simulation.Wait(5)
			this.fullAxi.m_axi_awready = 0b0
			this.fullAxi.m_axi_wready = 0b0
			this.fullAxi.m_axi_bvalid = 0b1
			Simulation.Wait(5)
			this.fullAxi.m_axi_bvalid = 0b0

		var hasLoopedToNextRxPoll = false

		for (var cycle = 0; cycle < 40; cycle++)
		{
			if (hasLoopedToNextRxPoll == false)
			{
				if (this.fullServer.GetAxiArvalid() == 0b1)
				{
					assert this.fullServer.GetAxiAraddr() == RX_PING_CONTROL
					hasLoopedToNextRxPoll = true
				}
			}

			Simulation.Wait(1)
		}

		assert hasLoopedToNextRxPoll == true
	}
}
