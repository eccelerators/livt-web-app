namespace Livt.WebApp

using Livt.IO
using Livt.Net
using Livt.Web.Http

/**
 * Serial owner of RX, route handlers and TX completion. Borrows acquired RX directly;
 * no second capture buffer. Keeps request/body views alive until emission completes.
 */
component WebApplication<R: IFrameReceiver, T: IFrameTransmitter>
{
	// Owned composition nodes; shared references never create another instance.
	ethernet: EthernetFrameParser<R>
	ipv4: Ipv4PacketParser<EthernetFrameParser<R>>
	connection: TcpConnectionRecognizer<R>
	request: HttpRequestParser<TcpConnectionRecognizer<R>>

	// Owned UART and borrowed link capabilities in the same reset domain.
	uart: IBufferedUart
	receiver: R
	transmitter: T

	// Borrowed TX publication and owned admission/completion coordinator.
	responseData: RamPacketData<1514>
	transfer: ResponseTransfer<T>

	// Owned shared parser/server graph, application routes and body providers.
	endpoint: HttpServer<R, WebRoutes<HttpRequestParser<TcpConnectionRecognizer<R>>>>
	routes: WebRoutes<HttpRequestParser<TcpConnectionRecognizer<R>>>
	fileStore: IndexHtmlStore
	aboutStore: AboutHtmlStore
	statusStore: StatusHtmlStore

	// Main owns frame acquisition and serializes all body mutations.
	bannerSent: bool
	receiveHeld: bool
	ethernetFrameDetected: logic

	// Counters describe prepared responses; low hexadecimal digits feed the page.
	arpCount: int
	icmpCount: int
	synCount: int
	rootCount: int
	aboutCount: int
	statusCount: int

	/**
	 * Constructs one shared request graph and application route tree. All bindings share reset.
	 */
	new(receiver: R, transmitter: T, responseData: RamPacketData<1514>,
		local_mac: in byte[6], local_ip: in byte[4], local_port: in byte[2],
		uart_rx: in logic, uart_tx: out logic, ethernet_frame_detected: out logic)
	{
		this.receiver = receiver
		this.transmitter = transmitter
		this.responseData = responseData
		this.transfer = new ResponseTransfer<T>(transmitter)
		this.fileStore = new IndexHtmlStore()
		this.aboutStore = new AboutHtmlStore()
		this.statusStore = new StatusHtmlStore()
		this.ethernet = new EthernetFrameParser<R>(receiver)
		this.ipv4 = new Ipv4PacketParser<EthernetFrameParser<R>>(ethernet)
		this.connection = new TcpConnectionRecognizer<R>(ethernet, ipv4)
		this.request = new HttpRequestParser<TcpConnectionRecognizer<R>>(connection)
		this.routes = new WebRoutes<HttpRequestParser<TcpConnectionRecognizer<R>>>(request, this.fileStore, this.aboutStore, this.statusStore)
		this.endpoint = new HttpServer<R, WebRoutes<HttpRequestParser<TcpConnectionRecognizer<R>>>>(receiver, ethernet, ipv4, connection, request, this.routes, local_mac, local_ip, local_port)
		this.uart = new BufferedUart<64, 128>(uart_rx, uart_tx)
		ethernet_frame_detected = this.ethernetFrameDetected
	}

	/**
	 * Resumes pending work and keeps RX/response storage stable through admission and completion.
	 */
	process Main()
	{
		this.ethernetFrameDetected = 0b0

		if (!this.bannerSent) {
			var banner = "Eccelerators GmbH\r\nFPGA Conference 2026\r\n".Encode()
			this.SendLog(banner)
			this.bannerSent = true
		}

		if (this.transfer.GetState() != ResponseTransferState.Idle) {
			if (this.transfer.Poll() != ResponseTransferState.Completed) {
				continue
			}

			var outcome = FrameTransmitOutcome.DeviceFailure
			this.transfer.TryGetCompletion(outcome)
			var completed = false

			if (outcome == FrameTransmitOutcome.Delivered && this.endpoint.MarkEmitted()) {
				completed = this.endpoint.Complete()
			}

			this.responseData.TryRelease()
			this.transfer.TryAcknowledgeCompletion()
			this.FinishFrame(!completed)
			continue
		}

		if (!this.receiveHeld) {
			if (this.receiver.TryAcquire() != FrameLinkResult.Success) {
				continue
			}

			this.receiveHeld = true
			this.ethernetFrameDetected = 0b1
			this.endpoint.HandleFrame()
		}

		var phase = this.endpoint.Poll()

		if (phase == HttpTransportState.Pending) {
			continue
		}

		if (phase != HttpTransportState.Prepared) {
			this.FinishFrame(phase == HttpTransportState.Failed)
			continue
		}

		this.RecordResponse()

		if (!this.PrepareTransfer()) {
			this.FinishFrame(true)
		}
	}

	/**
	 * Closes borrowers before RX release and refreshes the next status snapshot; TX must be stopped.
	 */
	fn FinishFrame(abort: bool)
	{
		if (abort) {
			this.endpoint.Abort()
		}

		if (this.endpoint.TryRelease() != PacketDataResult.Success) {
			return
		}

		if (this.receiver.TryRelease() == FrameLinkResult.Success) {
			this.receiveHeld = false
		}

		this.statusStore.SetCounters(this.arpCount, this.icmpCount, this.synCount, this.rootCount, this.aboutCount, this.statusCount)
	}

	/**
	 * Copies a complete checked response into the transmitter RAM and starts admission.
	 * The endpoint remains borrowed until terminal TX completion, including failures.
	 */
	fn PrepareTransfer() bool
	{
		var length = this.endpoint.GetAvailableLength()

		if (length < this.transmitter.GetMinimumFrameLength() || length > this.transmitter.GetMaximumFrameLength() || length > 1514) {
			return false
		}

		if (this.responseData.TryClear() != PacketDataResult.Success) {
			return false
		}

		for (var i = 0; i < length; i++) {
			var value: byte = 0x00

			if (this.endpoint.TryRead(i, value) != PacketDataResult.Success || this.responseData.TryWrite(i, value) != PacketDataResult.Success) {
				this.responseData.TryClear()
				return false
			}
		}

		if (this.responseData.TryPublish() != PacketDataResult.Success) {
			return false
		}

		if (this.transfer.TryBegin() != FrameLinkResult.Success) {
			this.responseData.TryRelease()
			return false
		}

		return true
	}

	/**
	 * Records each prepared response once; status body updates wait until its readers stop.
	 */
	fn RecordResponse()
	{
		var kind = this.endpoint.GetResponseKind()

		if (kind == HttpNetworkResponse.Arp) {
			this.arpCount = (this.arpCount + 1) % 16
		}

		if (kind == HttpNetworkResponse.IcmpEcho) {
			this.icmpCount = (this.icmpCount + 1) % 16
		}

		if (kind == HttpNetworkResponse.TcpSynAck) {
			this.synCount = (this.synCount + 1) % 16
		}

		var page = this.routes.GetPreparedPage()

		if (page == DemoPage.Home) {
			this.rootCount = (this.rootCount + 1) % 16
			var homeMessage = "GET /\r\n".Encode()
			this.SendLog(homeMessage)
		}

		if (page == DemoPage.About) {
			this.aboutCount = (this.aboutCount + 1) % 16
			var aboutMessage = "GET /about\r\n".Encode()
			this.SendLog(aboutMessage)
		}

		if (page == DemoPage.Status) {
			this.statusCount = (this.statusCount + 1) % 16
			var statusMessage = "GET /status\r\n".Encode()
			this.SendLog(statusMessage)
		}
	}

	/**
	 * Main is the only producer; skip complete chunks when UART space is insufficient.
	 */
	fn SendLog(data: byte[])
	{
		if (this.uart.GetTransmitSpace() < data.Length()) {
			return
		}

		this.uart.Send(data)
	}
}
