namespace Livt.WebApp

using Livt.Net

/**
 * Application-owned HTML provider. Keep bytes stable while a response borrows it.
 */
component StatusHtmlStore : IPacketData
{
	const CONTENT: byte[] = '<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><link href=https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css rel=stylesheet><script src=https://unpkg.com/htmx.org@2></script></head><body style="--bs-primary-rgb:37,63,142;color:#0a1a49;background:linear-gradient(120deg,rgba(37,63,142,.08),#f7f9fc)"><div class=d-flex><nav class="p-3 text-white" style="background:#253F8E;width:232px;min-height:100vh"><img src=https://eccelerators.com/images/eccelerators-logo.png class="img-fluid mb-4"><div class="d-grid gap-2"><a class="d-block p-2 rounded text-decoration-none text-white" href=/>Home</a><a class="d-block p-2 rounded text-decoration-none text-white" href=/about>About</a><a class="d-block p-2 rounded text-decoration-none bg-white text-primary" href=/status>Status</a></div></nav><main class="p-4"><div style=width:780px><p>FPGA served page</p><h1 style="color:#0a1a49">Status</h1><p>Network counters.</p><table class=table style=--bs-table-bg:transparent hx-get=/status hx-trigger="every 5s" hx-select=table hx-swap=outerHTML><tbody><tr><th>ARP</th><td>0x0</td></tr><tr><th>ICMP</th><td>0x0</td></tr><tr><th>TCP SYN</th><td>0x0</td></tr><tr><th>GET /</th><td>0x0</td></tr><tr><th>GET /about</th><td>0x0</td></tr><tr><th>GET /status</th><td>0x0</td></tr></tbody></table></div></main></div></body></html>'.Encode()

	// Byte positions of the six digits in the application-owned template.
	const ARP_OFFSET: int = 1126
	const ICMP_OFFSET: int = 1160
	const SYN_OFFSET: int = 1197
	const ROOT_OFFSET: int = 1232
	const ABOUT_OFFSET: int = 1272
	const STATUS_OFFSET: int = 1313

	// Snapshot digits; updated only after response readers stop.
	arpDigit: byte
	icmpDigit: byte
	synDigit: byte
	rootDigit: byte
	aboutDigit: byte
	statusDigit: byte

	/**
	 * Initializes the six counter digits to zero.
	 */
	new()
	{
		this.arpDigit = 0x30
		this.icmpDigit = 0x30
		this.synDigit = 0x30
		this.rootDigit = 0x30
		this.aboutDigit = 0x30
		this.statusDigit = 0x30
	}

	/**
	 * Updates the next status snapshot. Requires all response readers to have stopped.
	 */
	public fn SetCounters(arp: int, icmp: int, syn: int, root: int, about: int, status: int)
	{
		this.arpDigit = this.HexDigit(arp)
		this.icmpDigit = this.HexDigit(icmp)
		this.synDigit = this.HexDigit(syn)
		this.rootDigit = this.HexDigit(root)
		this.aboutDigit = this.HexDigit(about)
		this.statusDigit = this.HexDigit(status)
	}

	/**
	 * Formats the low hexadecimal digit of a nonnegative event count.
	 */
	fn HexDigit(value: int) byte
	{
		var digit = value % 16

		if (digit < 10) {
			return (0x30 + digit) as byte
		}

		return (0x41 + digit - 10) as byte
	}

	/**
	 * The content is always published; the owner serializes status updates.
	 */
	override fn IsReady() bool
	{
		return true
	}

	/**
	 * Returns the complete body byte length.
	 */
	override fn GetAvailableLength() int
	{
		return CONTENT.Length()
	}

	/**
	 * Reads a checked body byte; invalid reads publish no value.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (index < 0 || index >= CONTENT.Length()) {
			return PacketDataResult.Invalid
		}

		if (index == ARP_OFFSET) {
			value = this.arpDigit
			return PacketDataResult.Success
		}

		if (index == ICMP_OFFSET) {
			value = this.icmpDigit
			return PacketDataResult.Success
		}

		if (index == SYN_OFFSET) {
			value = this.synDigit
			return PacketDataResult.Success
		}

		if (index == ROOT_OFFSET) {
			value = this.rootDigit
			return PacketDataResult.Success
		}

		if (index == ABOUT_OFFSET) {
			value = this.aboutDigit
			return PacketDataResult.Success
		}

		if (index == STATUS_OFFSET) {
			value = this.statusDigit
			return PacketDataResult.Success
		}

		value = CONTENT[index]
		return PacketDataResult.Success
	}
}
