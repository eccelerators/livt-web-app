namespace Livt.WebApp
using Livt.Net
using Livt.Web.Http

/**
 * Application route/body policy. Borrows the three stores; the application must
 * keep their bytes stable while selected. Only the selected length is cached.
 */
component WebContent : IHttpContent
{
	index: IndexHtmlStore
	about: AboutHtmlStore
	status: StatusHtmlStore
	route: int
	length: int

	new(index: IndexHtmlStore, about: AboutHtmlStore, status: StatusHtmlStore)
	{
		this.index = index
		this.about = about
		this.status = status
	}

	override fn TrySelect(route: int) PacketDataResult
	{
		if (this.route != 0) {
			return PacketDataResult.Busy
		}

		if (route < 1 || route > 3) {
			return PacketDataResult.Invalid
		}

		if (route == 1) {

			if (!this.index.IsReady()) {
				return PacketDataResult.NotReady
			}

			this.length = this.index.GetLength()
		}

		if (route == 2) {

			if (!this.about.IsReady()) {
				return PacketDataResult.NotReady
			}

			this.length = this.about.GetLength()
		}

		if (route == 3) {

			if (!this.status.IsReady()) {
				return PacketDataResult.NotReady
			}

			this.length = this.status.GetLength()
		}

		this.route = route
		return PacketDataResult.Success
	}

	override fn Release()
	{
		this.route = 0
		this.length = 0
	}

	override fn IsReady() bool
	{
		return this.route != 0
	}

	override fn GetAvailableLength() int
	{
		return this.length
	}

	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (this.route == 0) {
			return PacketDataResult.NotReady
		}

		if (index < 0 || index >= this.length) {
			return PacketDataResult.Invalid
		}

		if (this.route == 1) {
			value = this.index.GetByte(index) as byte
		}

		if (this.route == 2) {
			value = this.about.GetByte(index) as byte
		}

		if (this.route == 3) {
			value = this.status.GetByte(index) as byte
		}

		return PacketDataResult.Success
	}
}
