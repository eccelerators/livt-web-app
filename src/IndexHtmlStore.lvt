namespace Livt.WebApp

// Application-owned static content store for the showcase HTML page.
component IndexHtmlStore
{
	const CONTENT: byte[] = '<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><link href=https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css rel=stylesheet></head><body style="--bs-primary-rgb:37,63,142;color:#0a1a49;background:linear-gradient(120deg,rgba(37,63,142,.08),rgba(0,188,212,.06)),#f7f9fc"><div class=d-flex><nav class="p-3 text-white" style="background:#253F8E;width:232px;min-height:100vh"><img src=https://eccelerators.com/images/eccelerators-logo.png class="img-fluid mb-4"><div class="d-grid gap-2"><a class="d-block p-2 rounded text-decoration-none bg-white text-primary" href=/>Home</a><a class="d-block p-2 rounded text-decoration-none text-white" href=/about>About</a><a class="d-block p-2 rounded text-decoration-none text-white" href=/status>Status</a></div></nav><main class="p-4 p-md-5"><div style="max-width:780px"><p class="text-primary small">FPGA served page</p><h1 style="color:#0a1a49">Livt FPGA</h1><p class=lead>A compact Artix-7 web server demo that returns complete HTTP responses directly from hardware logic.</p><hr><div class="d-flex gap-2 mt-4"><div class="card p-3 flex-fill">Routes<br><b class=fs-4>3</b></div><div class="card p-3 flex-fill">Runtime<br><b class=fs-4>No OS / No CPU</b></div><div class="card p-3 flex-fill">Assets<br><b class=fs-4>Remote</b></div></div></div></main></div></body></html> '.Encode()
	const CONTENT_LENGTH: int = 1377
	// Pairs from byte index 0 because the 4-digit Content-Length makes the
	// HTTP header 66 bytes long. Odd body length means finalization adds the final byte as high.
	const WORD_COUNT: int = 688

	wordSum: int
	wordIndex: int
	ready: bool

	new()
	{
		this.wordSum = 0
		this.wordIndex = 0
		this.ready = false
	}

	// Accumulates one big-endian 16-bit word per cycle for the aligned HTTP body.
	process Main()
	{
		if (this.ready == true)
		{
			continue
		}

		if (this.wordIndex < WORD_COUNT)
		{
			var hi: int = CONTENT[this.wordIndex * 2]
			var lo: int = CONTENT[this.wordIndex * 2 + 1]
			this.wordSum = this.wordSum + hi * 256 + lo
			this.wordIndex = this.wordIndex + 1
		}
		else
		{
			var last: int = CONTENT[CONTENT_LENGTH - 1]
			this.wordSum = this.wordSum + last * 256
			this.ready = true
		}
	}

	// Returns true when the word sum is computed and the store is ready.
	public fn IsReady() bool
	{
		return this.ready
	}

	// Returns the content length in bytes.
	public fn GetLength() int
	{
		return CONTENT_LENGTH
	}

	// Returns the pre-computed RFC 1071 word sum of the content.
	// Valid only after IsReady() returns true.
	public fn GetChecksumWordSum() int
	{
		return this.wordSum
	}

	// Returns one content byte by index.
	public fn GetByte(index: int) logic[8]
	{
		if (index < 0) { return 0x00 }
		if (index >= CONTENT_LENGTH) { return 0x00 }
		return CONTENT[index]
	}
}
