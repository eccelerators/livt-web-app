namespace Livt.WebApp

using Livt.Net

/**
 * Application-owned HTML provider. Keep bytes stable while a response borrows it.
 */
component IndexHtmlStore : IPacketData
{
	const CONTENT: byte[] = '<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><link href=https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css rel=stylesheet></head><body style="--bs-primary-rgb:37,63,142;color:#0a1a49;background:linear-gradient(120deg,rgba(37,63,142,.08),rgba(0,188,212,.06)),#f7f9fc"><div class=d-flex><nav class="p-3 text-white" style="background:#253F8E;width:232px;min-height:100vh"><img src=https://eccelerators.com/images/eccelerators-logo.png class="img-fluid mb-4"><div class="d-grid gap-2"><a class="d-block p-2 rounded text-decoration-none bg-white text-primary" href=/>Home</a><a class="d-block p-2 rounded text-decoration-none text-white" href=/about>About</a><a class="d-block p-2 rounded text-decoration-none text-white" href=/status>Status</a></div></nav><main class="p-4 p-md-5"><div style="max-width:780px"><p class="text-primary small">FPGA served page</p><h1 style="color:#0a1a49">Livt FPGA</h1><p class=lead>A compact Artix-7 web server demo that returns complete HTTP responses directly from hardware logic.</p><div class="d-flex gap-2 mt-4"><div class="card p-3 flex-fill">Routes<br><b class=fs-4>3</b></div><div class="card p-3 flex-fill">Runtime<br><b class=fs-4>No OS / No CPU</b></div><div class="card p-3 flex-fill">Assets<br><b class=fs-4>Remote</b></div></div></div></main></div></body></html> '.Encode()

	/**
	 * Static bytes are available immediately; no checksum initialization is needed.
	 */
	new()
	{
	}

	/**
	 * The content is always published; the owner serializes status updates.
	 */
	override fn IsReady() bool
	{
		return true
	}

	/**
	 * Returns the complete body byte length.
	 */
	override fn GetAvailableLength() int
	{
		return CONTENT.Length()
	}

	/**
	 * Reads a checked body byte; invalid reads publish no value.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (index < 0 || index >= CONTENT.Length()) {
			return PacketDataResult.Invalid
		}

		value = CONTENT[index]
		return PacketDataResult.Success
	}
}
