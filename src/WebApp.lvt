namespace Livt.WebApp

using Livt.Net
using Livt.Net.Drivers.EthernetLite

/**
 * Board composition root for the Web demo. Concrete EthernetLite wiring stays
 * here; WebApplication owns protocol work through frame-link capabilities.
 * Driver, storage, application and external MAC require coordinated reset.
 */
component WebApp
{
	// Independently constructed storage avoids RX/response/TX constructor cycles.
	receiver: EthernetLiteReceiver<128>
	responseData: RamPacketData<1514>
	transmitter: EthernetLiteTransmitter<RamPacketData<1514>>
	bus: EthernetLiteBus
	driver: EthernetLiteDriver<EthernetLiteBus, RamPacketData<1514>>
	application: WebApplication<EthernetLiteReceiver<128>, EthernetLiteTransmitter<RamPacketData<1514>>>

	/**
	 * Binds board signals/configuration and constructs the device-independent application.
	 */
	new(
		axi: IAxi4LiteEthernetLiteMaster,
		local_mac: in byte[6],
		local_ip: in byte[4],
		local_port: in byte[2],
		uart_rx: in logic,
		uart_tx: out logic,
		ethernet_frame_detected: out logic
	)
	{
		this.receiver = new EthernetLiteReceiver<128>()
		this.responseData = new RamPacketData<1514>()
		this.transmitter = new EthernetLiteTransmitter<RamPacketData<1514>>(this.responseData)
		this.bus = new EthernetLiteBus(axi)
		this.driver = new EthernetLiteDriver<EthernetLiteBus, RamPacketData<1514>>(this.bus, this.receiver, this.transmitter, local_mac)
		this.application = new WebApplication<EthernetLiteReceiver<128>, EthernetLiteTransmitter<RamPacketData<1514>>>(
			this.receiver, this.transmitter, this.responseData, local_mac, local_ip, local_port,
			uart_rx, uart_tx, ethernet_frame_detected)
	}
}
